# -------------------------------------------------------------------
.env
.env.*
!.env.example
auth.json

# -------------------------------------------------------------------
# Laravel & PHP
# -------------------------------------------------------------------
/vendor/
composer.phar
composer.lock

# Laravel Storage (except public)
storage/app/*
!storage/app/public

storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/*.log
storage/*.key
storage/pail

# Laravel Cache
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# PHPUnit
.phpunit.result.cache
.phpunit.cache

# Nova / Fleet
/.nova
/.fleet

# -------------------------------------------------------------------
# Node / JS (if using Mix or Vite)
# -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / Mix Builds
public/build
public/hot
public/storage

